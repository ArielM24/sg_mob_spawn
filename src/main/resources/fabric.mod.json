{
	"schemaVersion": 1,
	"id": "sg-mob-spawn",
	"version": "${version}",
	"name": "SG Mob Spawn",
	"description": "A mod that adds mob spawns for higher difficulty like illusioners, zombie horses, cave spiders, etc.",
	"authors": [
		"ArielM24"
	],
	"contact": {
		"homepage": "https://github.com/ArielM24/sg_mob_spawn",
		"sources": "https://github.com/ArielM24/sg_mob_spawn"
	},
	"license": "CC0-1.0",
	"icon": "assets/sg-mob-spawn/sg-mob-spawn.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.sg.mob_spawn.SGMobSpawn"
		],
		"client": [
			"com.sg.mob_spawn.SGMobSpawnClient"
		]
	},
	"mixins": [
		"sg-mob-spawn.mixins.json",
		{
			"config": "sg-mob-spawn.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}